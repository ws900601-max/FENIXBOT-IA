# Copie para .env (desenvolvimento) ou cadastre na Vercel (produção). Nunca envie o .env ao GitHub.

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRETA: dá acesso total ao banco. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- IA (escolha um) ---
# Gemini tem cota grátis: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=google            # ou openai
# AI_MODEL=gemini-2.5-flash     # opcional

# --- Teste grátis (dias) ---
TRIAL_DAYS=7

# --- WhatsApp (Meta) — opcional até conectar ---
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# --- Instagram (Meta) — opcional ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Mercado Pago — opcional ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
